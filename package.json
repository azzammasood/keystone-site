{
  "name": "keystone-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static site for Keystone: renders only the pipeline's published exports.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "data": "node scripts/fetch-data.mjs",
    "data:fixture": "node scripts/fetch-data.mjs --from fixtures/site-data",
    "schemas:check": "node scripts/sync-schemas.mjs --check",
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "parse5": "8.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
